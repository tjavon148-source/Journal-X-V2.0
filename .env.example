# Copy to .env.local.
# Everything here is exposed in the client bundle by design. Never put a
# Supabase service_role key or a Cloudinary API secret in a VITE_ variable.

# Supabase → Project Settings → API. Stores every row, plus image attachments.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudinary → Dashboard (cloud name) and Settings → Upload (preset).
# Video attachments go here instead of Supabase Storage. The preset must have
# its signing mode set to "Unsigned"; that is what authorises the upload, and
# it is safe to ship in the bundle. Both fall back to the project defaults in
# src/lib/cloudinary.ts if unset.
VITE_CLOUDINARY_CLOUD_NAME=ewoj42z2
VITE_CLOUDINARY_UPLOAD_PRESET=trading_journal_uploads
